{
    "name": "@reown/api",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "test": "jest --runInBand",
        "test:db": "npm run build && node tests/integration/auth-db.integration.cjs",
        "openapi:generate": "npm run build && node scripts/export-openapi.cjs && openapi-typescript openapi.json -o ../../shared/api/schema.d.ts",
        "openapi:check": "npm run build && node scripts/export-openapi.cjs --check && openapi-typescript openapi.json -o ../../shared/api/schema.d.ts --check",
        "prisma:validate": "prisma validate",
        "prisma:format": "prisma format",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:status": "prisma migrate status",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^11.1.0",
        "@nestjs/platform-express": "^11.1.0",
        "@nestjs/swagger": "^11.4.7",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.9",
        "express-rate-limit": "^8.7.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.1.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.23.1",
        "jest": "^30.0.0",
        "openapi-typescript": "^7.13.0",
        "prisma": "^7.10.1",
        "ts-jest": "^29.4.0",
        "typescript": "^5.9.0"
    }
}
