{
    "name": "@reown/api",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": "nest start --watch --path tsconfig.dev.json",
        "build": "nest build",
        "start": "node dist/main.js",
        "test": "jest --runInBand",
        "test:db": "npm run build && node tests/integration/auth-db.integration.cjs",
        "openapi:generate": "npm run build && node scripts/export-openapi.cjs && openapi-typescript openapi.json -o ../../shared/api/schema.d.ts",
        "openapi:check": "npm run build && node scripts/export-openapi.cjs --check && openapi-typescript openapi.json -o ../../shared/api/schema.d.ts --check",
        "prisma:validate": "prisma validate",
        "prisma:format": "prisma format",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:status": "prisma migrate status",
        "prisma:studio": "prisma studio",
        "test:redis": "npm run build && node tests/integration/redis.integration.cjs",
        "db:check": "node scripts/check-database.cjs",
        "kyc:models": "node scripts/fetch-kyc-models.cjs",
        "test:kyc-real": "npm run build && node tests/integration/kyc-real-cards.integration.cjs",
        "predev": "npm run prisma:generate",
        "prebuild": "npm run prisma:generate",
        "postbuild": "node scripts/check-build.cjs",
        "images:migrate:r2": "node scripts/migrate-product-images.cjs",
        "test:otp": "npm run build && node tests/integration/otp.integration.cjs",
        "test:inspection": "npm run build && node ../web/scripts/test-auth-live.cjs --inspection"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@aws-sdk/client-s3": "^3.1161.0",
        "@nestjs/common": "^11.1.0",
        "@nestjs/core": "^11.1.0",
        "@nestjs/platform-express": "^11.1.0",
        "@nestjs/swagger": "^11.4.7",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "bullmq": "^6.5.3",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.9",
        "exifr": "^7.1.3",
        "express-rate-limit": "^8.7.1",
        "heic-decode": "^2.1.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "libheif-js": "^1.23.5",
        "onnxruntime-node": "^1.31.1",
        "pg": "^8.23.1",
        "rate-limit-redis": "^6.0.2",
        "redis": "^6.3.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.5",
        "tesseract.js": "^7.0.0",
        "zod": "^3.25.76",
        "zxing-wasm": "^3.1.6"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.1.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mocha": "^10.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.23.1",
        "jest": "^30.0.0",
        "openapi-typescript": "^7.13.0",
        "prisma": "^7.10.1",
        "ts-jest": "^29.4.0",
        "typescript": "^5.9.0"
    }
}
