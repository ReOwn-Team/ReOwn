JWT_SECRET=
DATABASE_URL=
# Optional locally; configure for shared rate limits across API instances.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=reown:

# Optional trusted Next.js BFF rate-limit identity (same >=32-char secret on web).
# BFF_SHARED_SECRET=

# Legacy local photo directory, only for reading/migrating older uploads.
# PRODUCT_UPLOAD_DIR=/var/lib/reown/product-images

# Product photos: Cloudflare R2 S3 credentials, server-side only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=products
# Optional endpoint override must match the account's Cloudflare R2 hostname.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Email OTP, requires a verified sending domain on Resend.
RESEND_API_KEY=
RESEND_FROM="ReOwn <no-reply@example.com>"
# Optional separate >=32-character OTP secret; defaults to a derived JWT_SECRET key.
# OTP_SECRET=

# Official always-pass development keys; replace both for production.
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Product inspection: admin decides; AI returns observations only.
# Explicit opt-in: allow permits provider retention/training. Default stays deny.
OPENROUTER_DATA_COLLECTION=deny
# Free endpoints may take longer; 1000–120000 ms, default 90000.
OPENROUTER_REQUEST_TIMEOUT_MS=90000
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# Leave true on at least one worker instance; requires Redis. Disable in tests.
INSPECTION_WORKER_ENABLED=true
