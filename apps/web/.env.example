# Server-only settings; never prefix these with NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3001
# Must match NestJS CLIENT_ORIGIN (normally the same as WEB_ORIGIN).
API_CLIENT_ORIGIN=http://localhost:3001
REDIS_URL=redis://127.0.0.1:6379
WEB_SESSION_PREFIX=reown:web:
# Deployment only: share a random >=32-character secret with NestJS.
# BFF_SHARED_SECRET=
# Set only behind an ingress that overwrites this header and blocks direct access.
# WEB_CLIENT_IP_HEADER=x-real-ip

# Public sitekey; must match the API configuration.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
