{
  "name": "ReOwn",
  "source": "src/index.css",
  "tokens": {
    "colors": {
      "ground": "#f4f6f9",
      "surface": "#ffffff",
      "surface-2": "#f8f9fb",
      "sunken": "#eef1f5",
      "ink": "#172033",
      "ink-2": "#3d4659",
      "muted": "#5d6677",
      "line": "#e3e7ee",
      "line-2": "#d2d8e1",
      "accent": "#2563eb",
      "accent-hover": "#1d4ed8",
      "accent-soft": "#edf3fe",
      "accent-text": "#1d4ed8",
      "good": "#15803d",
      "good-soft": "#e9f6ee",
      "risk": "#c9372c",
      "risk-soft": "#fdeeed",
      "warn-soft": "#fdf6e7"
    },
    "font": "Be Vietnam Pro (self-hosted @fontsource, latin + vietnamese, 400-800)",
    "typeScale": {
      "xs": "0.8125rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.375rem"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "20px",
      "pill": "999px"
    },
    "shadow": "0 1px 2px rgb(23 25 26 / 5%), 0 6px 20px rgb(23 25 26 / 7%)",
    "focusRing": "0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent)",
    "motion": {
      "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
      "duration": "150-250ms"
    },
    "accentOptions": {
      "blue": "#2563eb",
      "green": "#0b7a5b",
      "orange": "#c2410c",
      "violet": "#7c3aed"
    }
  },
  "rules": [
    "One user-selectable accent (default blue; green/orange/violet) for actions, selection, links and per-month amount",
    "Green (good) fixed for trust A/B only; does not follow the accent",
    "Red only for risk (tier D/E, fraud flags, errors, ineligibility reasons)",
    "Prices in ink, bold, tabular numerals",
    "Minimum 14px for decision-relevant text",
    "Single SVG icon set, stroke 1.75",
    "Theme menu in header: Light / Dark / System + 4 accent swatches, persisted in localStorage, applied pre-render"
  ]
}