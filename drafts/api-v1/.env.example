# ---- Máy dev ----
# Bật công cụ demo: trả mã OTP trong response, nạp tiền giả, mô phỏng trả trễ.
# Cho phép dùng khoá bí mật mặc định. TUYỆT ĐỐI không đặt khi deploy.
DEV_TOOLS=true
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://reown:reown@localhost:5432/reown
CLIENT_ORIGIN=http://localhost:5173

# ---- Production (bắt buộc; mỗi khoá ≥ 32 ký tự ngẫu nhiên: openssl rand -hex 32) ----
JWT_SECRET=
OTP_SECRET=
PII_SECRET=
# Khoá base32 cho 2FA admin (thêm vào Google Authenticator). Production bắt buộc.
ADMIN_TOTP_SECRET=
# Bảo vệ route cron (/api/cron/jobs). Bắt buộc nếu dùng cron; thiếu thì route luôn trả 401.
CRON_SECRET=
# Chỉ bản demo công khai: true = phát mã OTP cho số admin kể cả khi chưa bật 2FA (ai cũng vào được trang quản trị).
DEMO_ADMIN_OPEN=
# Số tầng proxy đứng trước server (Render/Railway/Nginx thường là 1). Bỏ trống = không tin X-Forwarded-For.
TRUST_PROXY=
# strict (mặc định) | lax | none — dùng "none" khi frontend và API khác tên miền gốc (bắt buộc HTTPS)
COOKIE_SAMESITE=strict
JOBS_INTERVAL_SEC=300
